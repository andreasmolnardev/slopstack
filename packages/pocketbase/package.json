{
  "name": "@slopstack/pocketbase",
  "version": "0.1.0",
  "description": "Optional PocketBase adapters for Slopstack resources, auth, and realtime",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth-adapters.d.ts",
      "import": "./dist/auth-adapters.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@slopstack/core": "workspace:^"
  },
  "peerDependencies": {
    "pocketbase": ">=0.21",
    "react": ">=18",
    "@tanstack/react-query": ">=5"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "pocketbase": "^0.26.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "react": "^19.2.4",
    "@tanstack/react-query": "^5.90.12"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  }
}
