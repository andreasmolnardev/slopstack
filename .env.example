SLOPSTACK_HTTP_ADDRESS=0.0.0.0:8090
SLOPSTACK_PUBLIC_URL=http://localhost:8090
SLOPSTACK_SECURE_COOKIES=false
SLOPSTACK_REGISTRATION_ENABLED=true
SLOPSTACK_SSO_ONLY=false
SLOPSTACK_REQUIRE_VERIFIED_EMAIL=false
SLOPSTACK_LOG_LEVEL=info
SLOPSTACK_STORAGE_PATH=pb_data
SLOPSTACK_DEVELOPMENT=true
VITE_API_URL=http://localhost:8090

# Optional OpenAI-compatible course generation. Leave all blank for fixture lessons.
STARBURST_LLM_BASE_URL=
STARBURST_LLM_API_KEY=
STARBURST_LLM_MODEL=

# Optional Wyoming Piper speech service (reachable from the backend container)
STARBURST_WYOMING_PIPER_HOST=
STARBURST_WYOMING_PIPER_PORT=10200
STARBURST_WYOMING_WHISPER_HOST=
STARBURST_WYOMING_WHISPER_PORT=10300
